{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 10am on monday"],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "GitHub Actions stay pinned to commit SHAs",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Go major updates monthly",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["major"],
      "groupName": "Go major dependencies",
      "schedule": ["before 10am on the first day of the month"]
    },
    {
      "description": "The Renovate of make renovate-check (.github/renovate-check): package.json, its lockfile and the Node.js its engines require move together",
      "matchFileNames": [".github/renovate-check/**"],
      "groupName": "Renovate validator",
      "automerge": false
    },
    {
      "description": "Go tools pinned in the Makefile and ci.yml (TestMakefile_ToolVersionsMatchCI keeps them equal): one branch updates both files",
      "matchManagers": ["custom.regex"],
      "groupName": "Go tools",
      "automerge": false
    },
    {
      "description": "Vulnerable packages first",
      "matchDatasources": ["go"],
      "labels": ["security"],
      "prPriority": 10
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "GOLANGCI_LINT_VERSION (go run/go install github.com/golangci/golangci-lint/v2@version)",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION\\s*[=:]\\s*(?<currentValue>v[0-9][^\\s]*)"
      ],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "GOVULNCHECK_VERSION (go run/go install golang.org/x/vuln@version)",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "GOVULNCHECK_VERSION\\s*[=:]\\s*(?<currentValue>v[0-9][^\\s]*)"
      ],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "GOREG_VERSION (go run/go install github.com/magicdrive/goreg@version)",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "GOREG_VERSION\\s*[=:]\\s*(?<currentValue>v[0-9][^\\s]*)"
      ],
      "depNameTemplate": "github.com/magicdrive/goreg",
      "datasourceTemplate": "go"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 10am on monday"]
  },
  "ignorePaths": ["**/testdata/**", "**/*.golden"],
  "postUpdateOptions": ["gomodTidy"],
  "osvVulnerabilityAlerts": true
}
