# fish completion for hephaestus, generated by `hephaestus completion fish`.
# Install it as hephaestus.fish in a directory on $fish_complete_path, or
# load it with
#   hephaestus completion fish | source
# Candidates come from `hephaestus __complete`, which only reads the
# command's flag definitions.

function __hephaestus_complete
    set -l tokens (commandline -opc)
    set -l cur (commandline -ct)
    set -l cmd $tokens[1]
    set -e tokens[1]
    # "$cur" is quoted so that an empty word is still passed.
    set -l out ($cmd __complete $tokens "$cur" 2>/dev/null)
    or return
    set -l directive (string replace -- ':' '' $out[-1])
    set -e out[-1]
    if test "$directive" = 2
        set -l pre ''
        set -l value "$cur"
        if string match -q -- '-*=*' $cur
            set value (string replace -r -- '^[^=]*=' '' $cur)
            set pre (string replace -r -- '=.*$' '=' $cur)
        end
        for path in (__fish_complete_path "$value")
            printf '%s%s\n' $pre $path
        end
        return
    end
    printf '%s\n' $out
end

complete -c hephaestus -f -a '(__hephaestus_complete)'
