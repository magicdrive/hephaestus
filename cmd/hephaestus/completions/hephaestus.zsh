#compdef hephaestus
#
# zsh completion for hephaestus, generated by `hephaestus completion zsh`.
# Install it as "_hephaestus" in a directory on $fpath, or load it with
#   source <(hephaestus completion zsh)
# Candidates come from `hephaestus __complete`, which only reads the
# command's flag definitions.

_hephaestus() {
    local cur=${words[CURRENT]} out directive line
    local -a lines cands descs
    out=$("${words[1]}" __complete "${(@Q)words[2,CURRENT]}" 2>/dev/null) || return 1
    lines=("${(@f)out}")
    directive=${lines[-1]#:}
    lines=("${(@)lines[1,-2]}")

    if (( directive == 2 )); then
        [[ $cur == -*=* ]] && compset -P '*='
        _files
        return
    fi
    for line in $lines; do
        local word=${line%%$'\t'*}
        # For --flag=value the "--flag=" part is kept as a prefix.
        [[ $cur == -*=* ]] && word=${word#*=}
        cands+=("$word")
        if [[ $line == *$'\t'* ]]; then
            descs+=("$word  -- ${line#*$'\t'}")
        else
            descs+=("$word")
        fi
    done
    [[ $cur == -*=* ]] && compset -P '*='
    (( $#cands )) || return 1
    compadd -l -d descs -a cands
}

if [[ $funcstack[1] == _hephaestus ]]; then
    _hephaestus "$@"
else
    compdef _hephaestus hephaestus
fi
